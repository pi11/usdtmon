# --- Required -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgres://usdtmon:password@localhost:5432/usdtmon

# --- Blockchain providers -------------------------------------------------
# Any Ethereum JSON-RPC endpoint that supports eth_getLogs and the "finalized" tag.
ETHEREUM_RPC_URL=
# TronGrid (or a self-hosted java-tron node exposing /jsonrpc).
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=

# --- Monitoring -------------------------------------------------------------
# Default polling interval in seconds (a network's polling_interval column overrides it).
MONITOR_INTERVAL=30
# Per-cryptocurrency notification threshold override: <SYMBOL>_MIN_AMOUNT.
USDT_MIN_AMOUNT=0.5

# Optional per-network tuning (prefix ETHEREUM_ or TRON_).
# Keep comments on their own lines: systemd EnvironmentFile does not strip them.
# One of: finalized, confirmations
# ETHEREUM_FINALITY=finalized
# Used when FINALITY=confirmations
# ETHEREUM_CONFIRMATIONS=12
# eth_getLogs block range per request
# ETHEREUM_MAX_BLOCK_RANGE=500
# ETHEREUM_MAX_ADDRESSES_PER_QUERY=100
# ETHEREUM_REQUEST_TIMEOUT=15
# ETHEREUM_MAX_CONCURRENCY=4
# Requests per second
# ETHEREUM_RATE_LIMIT=10
# ETHEREUM_MAX_RETRIES=5
# Check tx status per matching transfer
# TRON_VERIFY_RECEIPTS=true
# TronGrid free tier allows ~15 rps with an API key
# TRON_RATE_LIMIT=10

# --- Notifications ----------------------------------------------------------
# NOTIFY_POLL_INTERVAL=2
# NOTIFY_MAX_ATTEMPTS=10
# Messages per second (Telegram global limit is ~30)
# NOTIFY_RATE_LIMIT=25

LOG_LEVEL=INFO
# One of: json, text
# LOG_FORMAT=json
